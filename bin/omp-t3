#!/usr/bin/env node
'use strict';

const { parseArgs, resolveOmpPath, shimVersionInfo } = require('../src/cli.js');
const { execSync, spawn } = require('node:child_process');
const { spawnAndProxy } = require('../src/proxy.js');
const { adaptT3ExtensionArgs, readDeferralLedger } = require('../src/extension_compat.js');
const { setupSessionSymlink } = require('../src/symlink.js');
const { ModelCatalogManager } = require('../src/model_catalog.js');
const pkg = require('../package.json');
const { createSubagentPolicy } = require('../src/subagent_policy.js');

let parsed;
try {
  parsed = parseArgs(process.argv.slice(2));
} catch (err) {
  console.error(`[omp-t3] Launch refused: ${err.message}`);
  process.exit(1);
}

switch (parsed.action) {
  case 'version': {
    // T3 probes the provider binary with --version and compares the first
    // semver token of stdout against MINIMUM_PI_VERSION (0.80.5). The first
    // three segments of our version track the upstream Pi release this shim
    // iteration targets (`<pi>-<iter>` in package.json), so line 1 is exactly
    // that Pi base. No other version-shaped token may appear in the output.
    const info = shimVersionInfo();
    if (!info) process.exit(1);
    console.log(info.piBase);
    console.log(`omp-t3 ${info.full} (Pi-compatible shim)`);
    process.exit(0);
    break;
  }

  case 'help': {
    console.log(`
omp-t3 - Out-of-process stdio RPC translator bridging T3 Code and Oh My Pi

Usage:
  omp-t3 [flags...]

T3 Code Setup:
  1. Open T3 Code -> Settings -> Providers -> Pi
  2. Set "Binary Path" to: omp-t3 (or absolute path from "which omp-t3")
  3. Leave Arguments empty
  4. Click Refresh to discover models and start chatting!

Commands & Flags:
  update [--self]    Self-update: reports the detected install channel and the
                     exact update command; add --yes to actually run it
  --check            Verify omp installation, model discovery, and symlinks
  --setup-symlink    Create ~/.pi/agent/sessions symlink for T3 Usage Dashboard
  --version, -v      Show version information
  --help, -h         Show this help message

Environment:
  OMPT3_DELEGATE_TASKS=0   Restore stock OMP tools. By default native task is
                           disabled and delegation uses T3 delegate_task.
  OMPT3_MAX_SUBAGENTS=<N>  Cap concurrent subagents at N: the shim injects
                           omp's task.maxConcurrency overlay (excess spawns
                           queue; the lead agent is told the limit). Unset or
                           invalid = no change to the launch.
  OMPT3_SUBAGENT_ALLOWED_MODELS     Comma-separated model IDs or * patterns.
                                    Defaults: glm-5.3-flash, gemini-3.8-flash,
                                    deepseek-v4.1-flash.
  OMPT3_SUBAGENT_DISALLOWED_MODELS  Deny rules win. Defaults: gpt-*sol*,
                                    *opus*, glm-5.3, glm-5.3:*.
  Empty values clear each list. Set BOTH lists empty to disable the model
  policy. Otherwise target.model is required and native task is blocked.

Explicit --tools lists override tool-list injection. Model restrictions remain active.
Other flags (e.g. --session, --fork, --hide-thinking) are forwarded to omp.
When --mode rpc is received from T3 Code, it is automatically rewritten to --mode rpc-ui.
`);
    process.exit(0);
    break;
  }

  case 'update': {
    // Feature 002 US8/FR2: T3's provider maintenance invokes `update --self`
    // routinely. The default is a successful no-op with manual guidance
    // (exit 0, never an unknown-option error); `--yes` opts into running the
    // detected package manager's update.
    const { updateSelf } = require('../src/updater.js');
    const result = updateSelf({ run: !!(parsed.options && parsed.options.yes) });
    for (const line of result.lines) console.log(line);
    process.exit(result.exitCode);
    break;
  }

  case 'setup-symlink': {
    const res = setupSessionSymlink(false);
    process.exit(res.success ? 0 : 1);
    break;
  }

  case 'check': {
    console.log('--- Checking OMP & T3 Integration Status ---');
    let hasErrors = false;

    // 1. Check OMP binary
    let ompPath = null;
    try {
      ompPath = resolveOmpPath();
      const ompVer = execSync(`"${ompPath}" --version`, { encoding: 'utf8', stdio: ['pipe', 'pipe', 'ignore'] }).trim();
      console.log(`[PASS] OMP binary found at: ${ompPath} (${ompVer})`);
    } catch (err) {
      console.error(`[FAIL] Could not locate omp binary: ${err.message}`);
      hasErrors = true;
    }

    // 2. Check Model Discovery
    if (ompPath) {
      try {
        const mgr = new ModelCatalogManager();
        const models = mgr.getModels(ompPath);
        const resp = mgr.createModelResponse('check-test', ompPath);
        const sizeKb = (Buffer.byteLength(resp, 'utf8') / 1024).toFixed(1);
        console.log(`[PASS] Model catalog discovery succeeded: ${models.length} models discovered.`);
        console.log(`       Safe payload size: ${sizeKb} KB (well within 1024 KB RPC limit).`);
      } catch (err) {
        console.error(`[FAIL] Model discovery error: ${err.message}`);
        hasErrors = true;
      }
    }

    // 3. Check Session Symlink
    const symRes = setupSessionSymlink(false);
    if (symRes.success) {
      console.log(`[PASS] Usage Dashboard session bridge verified.`);
    } else {
      console.warn(`[WARN] Session bridge check: ${symRes.message}`);
    }

    // 4. Self-update channel (feature 002 US8): never an error — informational
    const { detectInstallChannel } = require('../src/updater.js');
    const channel = detectInstallChannel();
    const channelCommand =
      channel.channel === 'npm' ? 'npm update -g omp-t3'
        : channel.channel === 'homebrew' ? 'brew upgrade hashangit/omp-t3/omp-t3'
          : 'git pull && npm install (in the omp-t3 checkout)';
    console.log(`[INFO] Self-update channel: ${channel.channel} (${channel.realpath}) — update with: ${channelCommand}`);

    // 5. Extension deferral ledger (feature 002 FR12): proves omp deferred
    //    this extension's startup (no first-message delay) after two
    //    unchanged launches
    {
      const ledger = readDeferralLedger();
      if (ledger.found && ledger.deferrable === true) {
        const match = ledger.fingerprintMatches === null
          ? 'fingerprint unchecked (compat copy not stat-able)'
          : ledger.fingerprintMatches ? 'fingerprint matches current compat copy' : 'fingerprint is stale (omp re-evaluates on next launch)';
        console.log(`[PASS] Extension deferral: deferred startup active (${match}).`);
      } else if (ledger.found) {
        console.warn(`[WARN] Extension deferral: ledger row exists but deferrable is false — omp loads it eagerly (first-message delay).`);
      } else {
        console.warn(`[WARN] Extension deferral: no ledger row yet (${ledger.error}) — run omp-t3 twice unchanged, then re-run --check.`);
      }
    }

    console.log('--------------------------------------------');
    if (hasErrors) {
      console.error('Integration checks failed.');
      process.exit(1);
    } else {
      console.log('All checks passed! omp-t3 is ready for T3 Code.');
      process.exit(0);
    }
    break;
  }

  case 'proxy':
  default: {
    const ompArgs = parsed.ompArgs || ['--mode', 'rpc-ui'];
    const enforced = parsed.delegation?.injectedTools === true;
    const launch = (args) => {
      adaptT3ExtensionArgs(args)
        .then(({ args: finalArgs, extensionPath }) => {
          spawnAndProxy(finalArgs, extensionPath ? { t3ExtensionPath: extensionPath } : {});
        })
        .catch((err) => {
          if (createSubagentPolicy().active) {
            console.error(`[omp-t3] Launch refused: ${err.message}`);
            process.exitCode = 1;
            return;
          }
          console.error(`[omp-t3] Extension adaptation failed (${err && err.message ? err.message : err}); launching without it.`);
          spawnAndProxy(args);
        });
    };

    if (enforced) {
      // Only shim-injected tools are validated. User-selected tools and
      // prompts are passed through unchanged, including on opt-out.
      const ompPath = resolveOmpPath();
      const args = ompArgs.slice();
      const probeTools = () => new Promise((resolve) => {
        const probe = spawn(ompPath, args, {
          stdio: ['pipe', 'pipe', 'pipe'],
          detached: process.platform !== 'win32',
          env: { ...process.env, PI_CODING_AGENT_DIR: require('node:path').join(require('node:os').homedir(), '.omp', 'agent') }
        });
        let stderr = '';
        let result = null;
        const killProbe = (signal = 'SIGKILL') => {
          try {
            if (process.platform === 'win32') probe.kill(signal);
            else if (probe.pid) process.kill(-probe.pid, signal);
          } catch (err) {
            if (err.code !== 'ESRCH') console.error(`[omp-t3] Probe cleanup failed: ${err.message}`);
          }
        };
        const signalHandlers = new Map();
        for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP']) {
          const handler = () => {
            killProbe();
            for (const [sig, fn] of signalHandlers) process.removeListener(sig, fn);
            process.kill(process.pid, signal);
          };
          signalHandlers.set(signal, handler);
          process.once(signal, handler);
        }
        const timer = setTimeout(() => {
          result = { ok: false, error: 'validation timed out before ready' };
          killProbe();
        }, 5000);
        const lines = require('node:readline').createInterface({ input: probe.stdout });
        lines.on('line', (line) => {
          try {
            if (!result && JSON.parse(line).type === 'ready') {
              result = { ok: true };
              clearTimeout(timer);
              killProbe();
            }
          } catch { /* Startup logs need not be JSON. */ }
        });
        probe.stderr.on('data', (data) => { stderr = (stderr + data).slice(-65536); });
        probe.once('error', (err) => { result = { ok: false, error: err.message }; });
        probe.once('close', (code, signal) => {
          clearTimeout(timer);
          lines.close();
          killProbe();
          for (const [sig, fn] of signalHandlers) process.removeListener(sig, fn);
          resolve(result || { ok: false, error: stderr || `exited before ready (${signal || code})` });
        });
      });
      (async () => {
        let reason = 'tool validation did not converge';
        for (let round = 0; round < 5; round++) {
          const result = await probeTools();
          if (result.ok) {
            launch(args);
            return;
          }
          reason = result.error;
          const match = reason.match(/(?:Unknown tools? in --tools|unavailable in this session): ([^\n]+)/);
          if (!match) break;
          const rejected = match[1].split(',').map((s) => s.trim().replace(/\.$/, ''));
          const idx = args.indexOf('--tools');
          const current = args[idx + 1].split(',');
          const kept = current.filter((name) => !rejected.includes(name));
          if (!kept.length || kept.length === current.length) break;
          args[idx + 1] = kept.join(',');
        }
        const shown = reason.split('\n')[0].replace(/[\u0000-\u001f\u007f]/g, '?');
        console.error(`[omp-t3] Delegation enforcement degraded: ${shown}. Launching with stock tooling and the original user arguments.`);
        launch(parsed.delegation.fallbackArgs);
      })().catch((err) => {
        console.error(`[omp-t3] Delegation validation failed: ${err.message}. Launching with the original user arguments.`);
        launch(parsed.delegation.fallbackArgs);
      });
    } else {
      launch(ompArgs);
    }
    break;
  }
}
